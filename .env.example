# OPENAI_API_KEY: Required for OpenAI API calls (GPT-4o / GPT-4o-mini).
# Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY="your_openai_api_key_here"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# AGORA_APP_ID: Agora RTC App ID for sub-280ms real-time audio channel.
# Obtain from https://console.agora.io/ (Project Management -> App ID)
AGORA_APP_ID="YOUR_AGORA_APP_ID"

# AGORA_APP_CERTIFICATE: Agora RTC App Certificate for secure token generation.
# Obtain from https://console.agora.io/ (Project Management -> Primary Certificate)
AGORA_APP_CERTIFICATE="YOUR_AGORA_APP_CERTIFICATE"

# VITE_AGORA_APP_ID: Exposed to client for direct Agora RTC initialization.
VITE_AGORA_APP_ID="YOUR_AGORA_APP_ID"
