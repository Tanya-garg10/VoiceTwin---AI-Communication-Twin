# ===========================================
# BACKEND ENVIRONMENT VARIABLES
# ===========================================

# Basic Server Configuration
PORT=4000
FRONTEND_URL=http://localhost:5173
AUTH_SECRET=replace-with-a-long-random-string

# Agora Voice Integration (Required for live voice sessions)
# Get from: https://console.agora.io
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Premium AI Features (Optional - unlocks advanced AI models)
# Get from: https://platform.openai.com
OPENAI_API_KEY=

# ===========================================
# FRONTEND ENVIRONMENT VARIABLES
# ===========================================

# Backend API URL
VITE_API_URL=http://localhost:4000

# Agora App ID (for frontend voice integration)
VITE_AGORA_APP_ID=

# Demo Mode (true = demo mode, false = live Agora integration)
VITE_DEMO_MODE=true
 